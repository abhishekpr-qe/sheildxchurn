# AI — Claude (T6 edge-case scoring, briefs, chat)
ANTHROPIC_API_KEY=your_anthropic_api_key

# AI — Gemini Flash (T5 high-risk enrichment)
GEMINI_API_KEY=your_gemini_api_key
ENABLE_GEMINI=true

# AI — OpenRouter (fallback gateway for T5/T6)
OPENROUTER_KEY=your_openrouter_key

# Redshift (production transaction data)
REDSHIFT_HOST=your-cluster.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_USER=your_user
REDSHIFT_PASSWORD=your_password
REDSHIFT_DB=dev

# Local PostgreSQL (predictions + LLM cost tracking)
LOCAL_PG_HOST=localhost
LOCAL_PG_PORT=5439
LOCAL_PG_USER=postgres
LOCAL_PG_PASSWORD=your_password
LOCAL_PG_DB=churndb

# PostgreSQL (cooldown persistence)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=churndb

# Mixpanel (behavioral events + user profiles)
MIXPANEL_API_SECRET=your_mixpanel_api_secret
MIXPANEL_TOKEN=your_mixpanel_token
MIXPANEL_PROJECT_ID=your_mixpanel_project_id

# MoEngage (push notifications + user sync)
MOENGAGE_APP_ID=your_moengage_app_id
MOENGAGE_API_KEY=your_moengage_api_key
MOENGAGE_DATA_API_KEY=your_moengage_data_api_key
MOENGAGE_API_URL=https://api-01.moengage.com

# Retell.ai (AI voice calls)
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=your_retell_agent_id

# AWS (S3 audit trail)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your_s3_bucket
AWS_REGION=ap-south-1

# Server ports
PORT=3001
PORT_FE=3000
BACKEND_URL=

# GitHub (rule evolution PR creation)
GITHUB_TOKEN=your_github_token
